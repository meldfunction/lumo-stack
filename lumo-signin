#!/bin/zsh
# lumo-signin — sign lumo-bridge in with Proton's password login (no browser needed).
# Asks for your Proton email, password, second password (if your account uses one) and the
# authenticator code in this terminal; the passwords are not stored.
# If Proton asks for a CAPTCHA, which this login can't show, it switches to lumo-login
# (the browser sign-in) automatically.
# Needs Go once to build the helper: brew install go
emulate -L zsh
source ${0:A:h}/lib.zsh
STATE=$LUMO_STACK/.login-state
state() { print -r -- "$1|$2|$(date +%s)" > $STATE; print -r -- "$2"; }
valid() { (cd $TAMER_DIR && node dist/src/tamer.js auth status 2>&1) | grep -q "configured and valid"; }
trap 'state failed "Sign-in cancelled."; exit 1' INT TERM

if [[ ! -x $TAMER_DIR/dist/proton-auth ]]; then
  command -v go >/dev/null || { state failed "Needs Go to build the login helper: brew install go"; exit 1; }
  state building "Building the login helper (one time)..."
  (cd $TAMER_DIR && npm run build:login) || { state failed "Couldn't build the login helper."; exit 1; }
fi
state waiting "Sign in to Proton below."
log=$(mktemp)
# `script` records the session (to spot a CAPTCHA) while keeping the terminal interactive
script -q $log zsh -c "cd ${(q)TAMER_DIR} && node dist/src/tamer.js auth login"
if grep -q "Code=9001\|CAPTCHA" $log; then
  rm -f $log; state waiting "Proton asked for a CAPTCHA. Switching to the browser sign-in..."
  exec $LUMO_STACK/lumo-login
fi
rm -f $log
state saving "Restarting lumo-bridge..."
launchctl kickstart -k gui/$(id -u)/$(agent lumo-tamer)
sleep 4
if valid; then
  state done "Signed in. Lumo is answering."
else
  state failed "Sign-in didn't finish. Check your password, second password and authenticator code, then retry."
  exit 1
fi
