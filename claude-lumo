#!/bin/zsh
# Optional add-on: Claude Code with Lumo as the ONLY model, no Anthropic account.
#   Claude Code -> LiteLLM (localhost) -> lumo-tamer -> Lumo
# Refuses to start if anything could route elsewhere. Not jailed: it runs on
# this Mac with Claude Code's own permission prompts. Use `lumo` for jailed work.
source ${0:A:h}/lib.zsh
LOG=$LOG_DIR/claude-lumo.log
log() { print -r -- "$(date '+%Y-%m-%d %H:%M:%S') [$$] $*" >> "$LOG"; }
die() { log "ABORT: $*"; print -u2 "claude-lumo: $*"; exit 1; }
command -v claude >/dev/null || die "Claude Code isn't installed (https://claude.com/claude-code)"
log "launch: cwd=$PWD args=$*"

# 1. LiteLLM may only route to lumo-tamer on localhost, or to Cloudflare Workers AI
#    on this account with an allowlisted (US/EU-origin) model. Anything else aborts.
[[ -r $LITELLM_CFG ]] || die "missing $LITELLM_CFG"
cfg=$(grep -vE '^\s*#' $LITELLM_CFG)
CF_BASE="https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID:-none}/ai/v1"  # account from lumo.env
print -r -- "$cfg" | grep -E '^\s*api_base:' | sed 's/^ *//' | sort -u \
  | grep -qvxF -e "api_base: http://127.0.0.1:$TAMER_PORT/v1" -e "api_base: $CF_BASE" -e "api_base: http://127.0.0.1:3301/v1" -e "api_base: http://127.0.0.1:11434" \
  && die "LiteLLM config routes somewhere other than lumo-tamer, Cloudflare Workers AI, tinfoil-proxy or local Ollama"
print -r -- "$cfg" | grep -E '^\s*model:' | grep -qvE 'model: (ollama_chat/(llama3\.1:8b|mistral-nemo:12b|gemma4:12b|gemma4:e4b)|openai/(lumo(-max|-lite)?|@cf/meta/llama-4-scout-17b-16e-instruct|@cf/mistralai/mistral-small-3\.1-24b-instruct|@cf/meta/llama-3\.3-70b-instruct-fp8-fast|@cf/meta/llama-3\.1-8b-instruct-fast|@cf/openai/gpt-oss-120b|@cf/google/gemma-4-26b-a4b-it|gpt-oss-120b|gemma4-31b|llama3-3-70b))$' \
  && die "LiteLLM config has a model outside the Lumo + Cloudflare allowlist"
# (the one allowed mention is LiteLLM's own setting name for the chat/completions translation)
print -r -- "$cfg" | grep -vxE '\s*use_chat_completions_url_for_anthropic_messages: true' | grep -qiE 'anthropic|claude' && die "LiteLLM config mentions anthropic/claude"
log "check: LiteLLM routes only to lumo-tamer + Cloudflare allowlist"

# 2. Servers up (starts them if needed).
${0:A:h}/lumo-up || die "stack didn't come up"

# 3. Every model slot is Lumo; no Anthropic key; no telemetry or update checks.
unset ANTHROPIC_API_KEY CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX
export ANTHROPIC_BASE_URL=http://localhost:$LITELLM_PORT
export ANTHROPIC_AUTH_TOKEN=$(litellm_key)
[[ -n $ANTHROPIC_AUTH_TOKEN ]] || die "no master_key in $LITELLM_CFG"
export ANTHROPIC_MODEL=lumo ANTHROPIC_DEFAULT_OPUS_MODEL=lumo-max ANTHROPIC_DEFAULT_SONNET_MODEL=lumo
# Pairing: Lumo reasons; a Cloudflare model with reliable tool calls does subagent/tool-heavy work.
# LUMO_TOOL_MODEL=lumo restores Lumo-only.
TOOL_MODEL=${LUMO_TOOL_MODEL:-cf-gptoss}  # best in lean harness 2026-11-20 (3/3, 21s)
export ANTHROPIC_DEFAULT_HAIKU_MODEL=$TOOL_MODEL ANTHROPIC_SMALL_FAST_MODEL=$TOOL_MODEL CLAUDE_CODE_SUBAGENT_MODEL=$TOOL_MODEL
# Lumo's real window is unknown; cap it so Claude Code compacts before Lumo truncates.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=${LUMO_CONTEXT_TOKENS:-100000}
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 DISABLE_AUTOUPDATER=1 DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1

# 4. No MCP servers (they open their own connections). LUMO_KEEP_MCP=1 keeps them.
mcp=(--strict-mcp-config); [[ $LUMO_KEEP_MCP == 1 ]] && mcp=()

# 5. Lean by default: no hooks/plugins/CLAUDE.md, 6 tools, a nudge to make real tool calls.
#    ~10x less input per turn -> faster Lumo, fewer Cloudflare neurons. LUMO_FULL=1 = full Claude Code.
# Lumo runs Claude Code's tools through lumo-tamer's custom tool protocol (tool-call JSON in the reply),
# so don't tell it "never write a tool call as JSON": that made it refuse to use the tools at all.
nudge="Your tools are real and run on this machine: use them to do the work instead of describing commands or asking the user to run them. When editing, prefer writing the whole file if an exact-match edit fails."
# Optional brief (LUMO_BRIEF=path in lumo.env): who/where Lumo is and the house rules. --bare skips
# CLAUDE.md, so it goes into the system prompt instead. Kept short: it is sent on every request.
brief=""; [[ -n $LUMO_BRIEF && -r $LUMO_BRIEF ]] && brief=$(<$LUMO_BRIEF)
lean=(--bare --tools "Read,Write,Edit,Grep,Glob,Bash" --append-system-prompt "$nudge${brief:+

$brief}")
[[ $LUMO_FULL == 1 ]] && lean=(${brief:+--append-system-prompt "$brief"})

# 6. Optional extra folders (LUMO_DIRS in lumo.env, colon-separated, e.g. your repo folders).
dirs=(); for d in ${(s.:.)LUMO_DIRS}; do [[ -d $d ]] && dirs+=(--add-dir "$d"); done
# 7. GitHub CLI: hand gh's existing login to the session as GITHUB_TOKEN/GH_TOKEN, so `gh` and
#    https git work from Lumo's commands without reading the Keychain. LUMO_NO_GH=1 = no GitHub.
if [[ $LUMO_NO_GH == 1 ]]; then unset GITHUB_TOKEN GH_TOKEN GITHUB_PERSONAL_ACCESS_TOKEN
elif [[ -z $GITHUB_TOKEN ]] && command -v gh >/dev/null; then
  GITHUB_TOKEN=$(env -u GH_TOKEN gh auth token 2>/dev/null) && [[ -n $GITHUB_TOKEN ]] && export GITHUB_TOKEN GH_TOKEN=$GITHUB_TOKEN
fi
[[ -n $GITHUB_TOKEN && -z $GH_TOKEN ]] && export GH_TOKEN=$GITHUB_TOKEN
# 8. Permission mode: "auto" can't work here (its safety check runs on Anthropic's servers and
#    LiteLLM doesn't pass it through), so every action would be refused. Use normal prompts
#    unless a mode was passed. And let sandboxed commands reach GitHub so gh/git work.
perm=(); [[ ${@[(I)--permission-mode*]} -gt 0 || ${@[(I)--dangerously-skip-permissions]} -gt 0 ]] || perm=(--permission-mode default)
gh_hosts='"github.com","api.github.com","uploads.github.com","codeload.github.com","objects.githubusercontent.com","raw.githubusercontent.com"'
# 9. Sandbox on: Lumo's shell commands run in Claude Code's OS sandbox (writes limited to the work
#    folders, network only to allowed hosts), whatever the user's own settings say. LUMO_NO_SANDBOX=1 = off.
#    With GitHub on, the GitHub hosts are allowed, plus macOS's trust service (trustd): Go programs
#    like gh verify TLS through it, and the sandbox blocks it otherwise ("x509: OSStatus -26276").
net=""; [[ $LUMO_NO_GH == 1 ]] || net=",\"network\":{\"allowedDomains\":[$gh_hosts],\"allowMachLookup\":[\"com.apple.trustd.agent\"]}"
sandbox=true; [[ $LUMO_NO_SANDBOX == 1 ]] && sandbox=false
perm+=(--settings "{\"sandbox\":{\"enabled\":$sandbox$net}}")
log "start: model=lumo tool=$TOOL_MODEL ctx=$CLAUDE_CODE_MAX_CONTEXT_TOKENS mcp=${mcp:-kept} mode=$([[ $LUMO_FULL == 1 ]] && print full || print lean) brief=${brief:+$LUMO_BRIEF} dirs=$(( $#dirs / 2 )) gh=${GITHUB_TOKEN:+yes} sandbox=$sandbox"
claude "${mcp[@]}" "${lean[@]}" "${dirs[@]}" "${perm[@]}" "$@"
code=$?
log "exit: code=$code"
exit $code
